import express, { Request, Response, NextFunction } from 'express';
import { ContextBuilder } from '../context/contextBuilder.js';
import { Scheduler, type SchedulerDeps } from '../scheduler/fsm.js';
import { LlmProviderFactory, type ProviderConfig } from '../llm/providerFactory.js';
import { MultimodalProcessor } from '../multimodal/processor.js';
import { LanguageAsAService } from '../multimodal/languageService.js';
import type { ContextPack, KgmRequest } from '../core/types.js';

export const playgroundRouter = express.Router();

// 初始化多模态处理器和语言服务 - 信任委托与代理服务
const multimodalProcessor = new MultimodalProcessor();
const langService = new LanguageAsAService(multimodalProcessor, {
  enableCache: true,
  maxCacheSize: 100,
  timeoutMs: 30000,
  maxConcurrency: 3
}, {
  delegationEnabled: true,
  enrichmentLevel: 'comprehensive',
  knowledgeGraphCompletion: true
});

playgroundRouter.post('/trust-proxy-process', async (req: Request, res: Response) => { // 信任委托API端点
  console.log('[Trust Proxy] Processing request with comprehensive context and knowledge graph completion');
  try {
    const { prompt, model, temperature = 0.7, maxTokens = 1024, mediaInputs } = req.body;

    // 信任委托 - 通过丰富的上下文API接口选择模型提供商
    let providerConfig: ProviderConfig;
    if (model) {
      providerConfig = {
        type: model as any,
        model: getBestModelForTask(model, prompt), // 根据任务选择最合适的模型
        apiKey: getApiKeyForProvider(model) // 从环境变量获取API密钥
      };
    } else {
      // 默认使用OpenAI
      providerConfig = {
        type: 'openai',
        model: process.env.KGM_LLM_MODEL || 'gpt-4o-mini',
        apiKey: process.env.OPENAI_API_KEY
      };
    }
    
    console.log('[Trust Proxy] Selected provider:', providerConfig.type, 'for request:', prompt.substring(0, 50) + '...');

    // 创建模型客户端
    const client = LlmProviderFactory.createClient(providerConfig);
    
    // 添加基本输入
    let finalPrompt = prompt;
    
    // 信任委托 - 通过知识图谱补全和上下文丰富性处理多模态内容
    if (mediaInputs) {
      const mediaContent = [];
      
      // 处理图片
      if (mediaInputs.images && mediaInputs.images.length > 0) {
        for (const imageName of mediaInputs.images) {
          // 在实际实现中，这里会处理上传的图片
          // 暂时简单处理，实际应该从上传的文件中提取信息
          mediaContent.push(`Image: ${imageName} (image content would be processed here)`);
        }
      }
      
      // 处理音频
      if (mediaInputs.audio) {
        mediaContent.push(`Audio: ${mediaInputs.audio} (audio content would be transcribed here)`);
      }
      
      // 处理视频
      if (mediaInputs.video) {
        mediaContent.push(`Video: ${mediaInputs.video} (video content would be analyzed here)`);
      }
      
      if (mediaContent.length > 0) {
        // 构建丰富上下文 - 信任委托的基础
        finalPrompt = `[Context Enrichment: Comprehensive]
[Media Inputs: ${mediaContent.length} items]
${mediaContent.join('
')}

[User Request]: ${prompt}

[Trust Delegation: Active]
[Knowledge Graph: Enabled]
[Information Completeness: Enhanced]`;
      }
    }

    // 信任代理 - 通过计算模型情景和效用适配逻辑处理请求
    console.log('[Trust Proxy] Executing completion with context-enriched prompt');
    const result = await client.complete(finalPrompt, {
      temperature,
      maxTokens
    });
    
    console.log('[Trust Proxy] Completion result received, applying audit trail');

    // 信任代理 - 生成可审计的响应
    const response = await processOutputBasedOnRequest(prompt, result);
    
    // 添加信任代理元数据
    response._trustMetadata = {
      timestamp: new Date().toISOString(),
      contextEnrichmentLevel: 'comprehensive',
      knowledgeGraphCompletion: true,
      trustDelegationActive: true,
      auditTrail: true
    };

    res.json(response);
  } catch (error) {
    console.error('Playground API Error:', error);
    res.status(500).json({ 
      error: '处理请求时发生错误',
      details: error instanceof Error ? error.message : 'Unknown error'
    });
  }
});

/**
 * 根据任务类型选择最佳模型
 */
function getBestModelForTask(provider: string, prompt: string): string {
  const lowerPrompt = prompt.toLowerCase();
  
  // 根据提示内容和提供商选择最合适的模型
  if (provider === 'zhipu' && (lowerPrompt.includes('中文') || lowerPrompt.includes('chinese'))) {
    return 'glm-4';
  } else if (provider === 'openai') {
    if (lowerPrompt.includes('code') || lowerPrompt.includes('programming')) {
      return 'gpt-4o';
    } else if (lowerPrompt.includes('math') || lowerPrompt.includes('calculate')) {
      return 'gpt-4o';
    } else {
      return process.env.KGM_LLM_MODEL || 'gpt-4o-mini';
    }
  } else if (provider === 'ollama') {
    return process.env.OLLAMA_DEFAULT_MODEL || 'llama3';
  } else if (provider === 'minimax') {
    return 'abab6.5-chat';
  } else {
    // 返回默认模型
    return process.env.KGM_LLM_MODEL || 'gpt-4o-mini';
  }
}

/**
 * 从环境变量获取API密钥
 */
function getApiKeyForProvider(provider: string): string | undefined {
  switch (provider) {
    case 'zhipu':
      return process.env.ZHIPU_API_KEY;
    case 'minimax':
      return process.env.MINIMAX_API_KEY;
    case 'openrouter':
      return process.env.OPENROUTER_API_KEY;
    case 'nvidia':
      return process.env.NVIDIA_API_KEY;
    case 'deepseek':
      return process.env.DEEPSEEK_API_KEY;
    case 'vllm':
      return process.env.VLLM_API_KEY;
    case 'slang':
      return process.env.SLANG_API_KEY;
    case 'openai':
    default:
      return process.env.OPENAI_API_KEY;
  }
}

/**
 * 根据请求内容处理输出
 */
async function processOutputBasedOnRequest(prompt: string, llmResult: any): Promise<any> {
  const lowerPrompt = prompt.toLowerCase();
  
  // 检测请求类型并生成相应输出
  const response: any = {
    text: llmResult?.text || llmResult || '处理完成',
    images: [],
    video: null,
    audio: null
  };

  // 检查是否请求生成图片
  if (lowerPrompt.includes('生成图片') || 
      lowerPrompt.includes('image') || 
      lowerPrompt.includes('picture') ||
      lowerPrompt.includes('draw')) {
    
    // 在实际实现中，这里会调用图像生成API
    // 暂时返回模拟的图片URL
    response.images = [`/generated-images/mock-${Date.now()}.jpg`];
  }
  
  // 检查是否请求生成视频
  if (lowerPrompt.includes('生成视频') || 
      lowerPrompt.includes('video') || 
      lowerPrompt.includes('animate')) {
    
    // 在实际实现中，这里会调用视频生成API
    // 暂时返回模拟的视频URL
    response.video = `/generated-videos/mock-${Date.now()}.mp4`;
  }
  
  // 检查是否请求生成音频
  if (lowerPrompt.includes('生成音频') || 
      lowerPrompt.includes('audio') || 
      lowerPrompt.includes('speech') ||
      lowerPrompt.includes('声音')) {
    
    // 在实际实现中，这里会调用音频生成API
    // 暂时返回模拟的音频URL
    response.audio = `/generated-audio/mock-${Date.now()}.mp3`;
  }

  return response;
}

// 添加CORS中间件支持
playgroundRouter.use((req: Request, res: Response, next: NextFunction) => {
  res.header('Access-Control-Allow-Origin', '*');
  res.header('Access-Control-Allow-Methods', 'GET, POST, PUT, DELETE, OPTIONS');
  res.header('Access-Control-Allow-Headers', 'Origin, X-Requested-With, Content-Type, Accept, Authorization');
  
  if (req.method === 'OPTIONS') {
    res.sendStatus(200);
  } else {
    next();
  }
});

export default playgroundRouter;