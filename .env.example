# KGM-Computing Runtime 环境变量配置示例

# 智谱AI (Zhipu) 配置
ZHIPU_API_KEY=your_zhipu_api_key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_DEFAULT_MODEL=glm-4

# Minimax 配置
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_GROUP_ID=your_group_id
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_DEFAULT_MODEL=abab6.5-chat

# OpenRouter 配置
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4-turbo

# NVIDIA 配置
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DEFAULT_MODEL=meta/llama3-70b-instruct

# DeepSeek 配置
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# Ollama 配置
OLLAMA_BASE_URL=http://localhost:11434/api
OLLAMA_DEFAULT_MODEL=llama3

# vLLM 配置
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=your_vllm_api_key_if_needed
VLLM_DEFAULT_MODEL=meta-llama/Llama-2-7b-hf

# SGLang 配置（OpenAI 兼容端口，默认根路径含 /v1）
SGLANG_BASE_URL=http://localhost:7860/v1
SGLANG_API_KEY=your_sglang_api_key_if_needed
SGLANG_DEFAULT_MODEL=default-model

# 原有的 KGM 配置
KGM_EMBEDDING_BASE_URL=
KGM_EMBEDDING_API_KEY=
KGM_EMBEDDING_MODEL=text-embedding-3-large
KGM_EMBEDDING_PATH=/embeddings
KGM_EMBEDDING_VERSION=

KGM_LLM_BASE_URL=
KGM_LLM_API_KEY=
KGM_LLM_MODEL=gpt-4o-mini
KGM_LLM_PATH=/chat/completions
KGM_LLM_MODE=chat
KGM_LLM_TEMPERATURE=0.2
KGM_LLM_MAX_TOKENS=1024

KGM_DB_PROVIDER=sqlite
KGM_DB_PATH=data/kgm.sqlite
KGM_DB_JOURNAL=WAL

KGM_VECTOR_BACKEND=chroma
KGM_VECTOR_BASE_URL=http://localhost:8000
KGM_VECTOR_API_PATH=/api/v1
KGM_VECTOR_COLLECTION=kgm_memory
KGM_VECTOR_DISTANCE=cosine

KGM_MOCK_MODE=0

# 服务器端口
PORT=3000