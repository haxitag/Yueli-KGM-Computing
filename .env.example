# KGM-Computing Runtime 环境变量配置示例

# 智谱AI (Zhipu) 配置
ZHIPU_API_KEY=your_zhipu_api_key
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_DEFAULT_MODEL=glm-4

# Minimax 配置
MINIMAX_API_KEY=your_minimax_api_key
MINIMAX_GROUP_ID=your_group_id
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_DEFAULT_MODEL=abab6.5-chat

# OpenRouter 配置
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=openai/gpt-4-turbo

# NVIDIA 配置
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DEFAULT_MODEL=meta/llama3-70b-instruct

# DeepSeek 配置
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# Ollama 配置（provider 原生 /api；managed pull 会自动剥离尾部 /api 再拼 /api/pull）
# 若要用 tools/stream，设 OLLAMA_OPENAI_BASE 走 OpenAI 兼容 /v1（HttpLlmClient）
OLLAMA_BASE_URL=http://localhost:11434/api
# OLLAMA_OPENAI_BASE=http://localhost:11434/v1
OLLAMA_DEFAULT_MODEL=llama3

# vLLM 配置（BASE_URL 供 provider；managed attach 需显式 KGM_VLLM_ATTACH=1，避免 .env 默认 URL 误伤 spawn）
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=your_vllm_api_key_if_needed
VLLM_DEFAULT_MODEL=meta-llama/Llama-2-7b-hf
# KGM_VLLM_ATTACH=1

# SGLang 配置（OpenAI 兼容端口，默认根路径含 /v1；managed attach 需 KGM_SGLANG_ATTACH=1）
SGLANG_BASE_URL=http://localhost:7860/v1
SGLANG_API_KEY=your_sglang_api_key_if_needed
SGLANG_DEFAULT_MODEL=default-model
# KGM_SGLANG_ATTACH=1

# 原有的 KGM 配置
KGM_EMBEDDING_BASE_URL=
KGM_EMBEDDING_API_KEY=
KGM_EMBEDDING_MODEL=text-embedding-3-large
KGM_EMBEDDING_PATH=/embeddings
KGM_EMBEDDING_VERSION=

KGM_LLM_BASE_URL=
KGM_LLM_API_KEY=
KGM_LLM_MODEL=gpt-4o-mini
KGM_LLM_PATH=/chat/completions
KGM_LLM_MODE=chat
KGM_LLM_TEMPERATURE=0.2
KGM_LLM_MAX_TOKENS=1024

# --- HTTP 访问加固（生产红线）---
# NODE_ENV=production 或 KGM_HTTP_SECURITY_MODE=strict → 强制 API Key；未设限流时默认 120/分钟
# 本地开发保持 permissive（可不设 Key）
# KGM_HTTP_SECURITY_MODE=strict
# KGM_HTTP_API_KEY=change-me
# 管理钥（master）：用于 /v1/kgm/keys|usage|budgets 等运维 API
# 调用钥（virtual）：Playground「运维→访问」签发的 kgm_…，可带预算与模型白名单
# KGM_OPS_DB_PATH=data/kgm-ops.sqlite
# KGM_HTTP_AUTH_EXEMPT=/health,/ready,/metrics,/openapi.json
# KGM_READY_REQUIRE_UPSTREAM=0
# KGM_STREAM_IDLE_MS=0
# KGM_GRAPH_MAX_TRIPLES=8
# --- Docker Compose 部署提示 ---
# docker compose up --build
# 会启动 chroma + frontstation-worker + kgm；compose 会自动把 INTENT/RERANK/SUMMARY URL
# 指到 http://frontstation-worker:8091/...（覆盖下方注释默认）。
# 单机 npm 开发：保持 worker URL 注释，依赖 PREFER_ONNX / local_neural 回退。
# 前站浅层（encoder 轨；与 decoder-only Native GPU 分轨）
# mode: auto | onnx | http | local_neural | heuristic | off
KGM_FRONTSTATION_MODE=auto
KGM_FRONTSTATION_INTENT_MODE=auto
KGM_FRONTSTATION_RERANK_MODE=auto
KGM_FRONTSTATION_SUMMARY_MODE=local
# 优先加载本机 MiniLM ONNX（@huggingface/transformers）；失败回退 HTTP / local_neural
KGM_FRONTSTATION_PREFER_ONNX=1
KGM_FRONTSTATION_ONNX_MODEL=Xenova/all-MiniLM-L6-v2
# KGM_FRONTSTATION_ONNX_DEVICE=cpu
# KGM_FRONTSTATION_ONNX_DTYPE=fp32
# Python micro-worker（真 CrossEncoder / CUDA）：先 npm run frontstation:worker:install && npm run frontstation:worker
# 未启动 worker 时请保持下列 URL 注释，避免 auto 模式无谓 HTTP 超时；启用时取消注释
# KGM_FRONTSTATION_INTENT_URL=http://127.0.0.1:8091/v1/intent
# KGM_FRONTSTATION_RERANK_URL=http://127.0.0.1:8091/v1/rerank
# KGM_FRONTSTATION_SUMMARY_URL=http://127.0.0.1:8091/v1/summarize
KGM_FRONTSTATION_TIMEOUT_MS=8000
# KGM_FRONTSTATION_WORKER_HOST=127.0.0.1
# KGM_FRONTSTATION_WORKER_PORT=8091
# KGM_FRONTSTATION_WORKER_DEVICE=auto
# KGM_FRONTSTATION_WORKER_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# KGM_FRONTSTATION_WORKER_CE_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# KGM_HTTP_RATE_LIMIT_MAX=120
# KGM_HTTP_RATE_LIMIT_WINDOW_MS=60000
# KGM_HTTP_TRUST_PROXY=0

# KGM_SANDBOX_BROWSER_USE_EMBEDDED=1

# --- CORS（主服务 / Playground / combined 同源策略）---
# 生产 / strict：未设置时禁止 *，且不回显任意 Origin；需显式白名单
# 开发默认：仅 localhost / 127.0.0.1 常见端口（3000、5173）
# KGM_CORS_ORIGINS=https://app.example,https://admin.example
# KGM_CORS_ORIGINS=*   # 显式放开全部源时禁止 credentials
# KGM_CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS,PATCH
# KGM_CORS_HEADERS=Content-Type,Authorization,X-API-Key,X-KGM-Error,X-KGM-Output-Normalize
# KGM_CORS_MAX_AGE=86400

# --- 上游熔断（opossum，按 host）---
# KGM_CIRCUIT_BREAKER_TIMEOUT_MS=10000
# KGM_CIRCUIT_BREAKER_ERROR_THRESHOLD=5
# KGM_CIRCUIT_BREAKER_RESET_TIMEOUT_MS=60000

# --- Worker 自动重启（spawn: vLLM / SGLang / llama.cpp / ds4 / MLX）---
# KGM_WORKER_AUTO_RESTART=1
# KGM_WORKER_RESTART_MAX_ATTEMPTS=5
# KGM_WORKER_RESTART_BASE_MS=1000
# KGM_WORKER_RESTART_MAX_MS=60000

# --- llama.cpp managed worker（通用 GGUF）---
# KGM_LLAMA_CPP_ENABLED=auto
# KGM_LLAMA_SERVER_CMD=llama-server
# KGM_LLAMA_CPP_INSTALL_HINT=
# KGM_LLAMA_CPP_BASE_URL=http://127.0.0.1:8080/v1
# KGM_LLAMA_CPP_ATTACH=1

# --- ds4 managed worker（DeepSeek V4 / GLM 专用 GGUF；内核不并入 native-gpu）---
# KGM_DS4_ENABLED=auto
# KGM_DS4_SERVER_CMD=ds4-server
# KGM_DS4_PORT=8090
# KGM_DS4_BASE_URL=http://127.0.0.1:8090/v1
# KGM_DS4_ATTACH=1
# KGM_DS4_CHDIR=
# KGM_DS4_INSTALL_HINT=
# KGM_DS4_CTX=32768
# KGM_DS4_BATCHED_SESSION=8
# KGM_DS4_SSD_STREAMING=0
# KGM_DS4_SSD_STREAMING_CACHE_EXPERTS=
# KGM_DS4_KV_DISK_DIR=
# KGM_DS4_KV_DISK_SPACE_MB=8192
# KGM_DS4_KV_DISK_ENABLED=0

# --- TokenSpeed optional OpenAI-compat worker（默认 off；生产推荐 auto + BASE_URL attach，类 Ollama）---
# KGM_TOKENSPEED_ENABLED=off
# KGM_TOKENSPEED_BASE_URL=http://127.0.0.1:8095/v1
# KGM_TOKENSPEED_ATTACH=0
# KGM_TOKENSPEED_SERVER_CMD=tokenspeed
# KGM_TOKENSPEED_PORT=8095
# KGM_TOKENSPEED_TOOL_CALL_PARSER=
# KGM_TOKENSPEED_REASONING_PARSER=
# KGM_TOKENSPEED_PREFIX_CACHING=1
# KGM_TOKENSPEED_EXTRA_ARGS=
# KGM_TOKENSPEED_INSTALL_HINT=

# --- Native / 本地发现（进程级；Playground 运维页只读展示）---
# auto | js-reference | native-core | native-gpu
# KGM_NATIVE_SERVING_BACKEND=auto
# 仅用于明确标记的模拟回归；不要当成生产 GPU
# KGM_NATIVE_GPU_SIMULATED=0
# KGM_NATIVE_CORE_LIBRARY=
# KGM_NATIVE_CORE_ADDON=
# KGM_NATIVE_PROMPT_CACHE_SIZE=8
# KGM_NATIVE_SESSION_CACHE_SIZE=64
# KGM_DISCOVERY_ENABLED=0
# KGM_DISCOVERY_PORTS=11434,8002,8080,1234,8000,5000,7860,8765,8095,8090
# KGM_DISCOVERY_TIMEOUT_MS=2000

# KGM_DB_PROVIDER=sqlite
# KGM_DB_PATH=data/kgm.sqlite
# KGM_DB_JOURNAL=WAL

# KGM_VECTOR_BACKEND=chroma
# KGM_VECTOR_BASE_URL=http://localhost:8000
# KGM_VECTOR_API_PATH=/api/v1
# KGM_VECTOR_COLLECTION=kgm_memory
# KGM_VECTOR_DISTANCE=cosine

# KGM_MOCK_MODE=0

# # 服务器端口
# PORT=58691

# # 阅粒云端 YueliAI v1 推理聚合（Playground 可写入 KgmConfig.yueliai，环境变量优先）
# YUELIAI_HOST=
# YUELIAI_API_KEY=
# YUELIAI_UPSTREAM_PREFIX=/api
# YUELIAI_TIMEOUT_MS=120000

# KGM_TOKENSPEED_ENABLED=auto 
# KGM_TOKENSPEED_BASE_URL=http://127.0.0.1:8095/v1